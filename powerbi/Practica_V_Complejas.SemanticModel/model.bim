          {
            "name": "Logistica_Global",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = #table(",
                "        type table [",
                "            ID_Pedido = Int64.Type,",
                "            Mes = text,",
                "            #\"Región\" = text,",
                "            Tipo_Envio = text,",
                "            Ventas_USD = Int64.Type,",
                "            Costo_Envio_USD = Int64.Type,",
                "            Dias_Entrega = number",
                "        ],",
                "        {",
                "            {1000, \"Enero\", \"Norte\", \"Estándar\", 18500, 1200, 5.4},",
                "            {1001, \"Enero\", \"Norte\", \"Express\", 11000, 3400, 1.6},",
